# Browser-safe Supabase API URL and publishable/legacy anon key only.
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-api-key

# Server-only; use your deployment secret store, never commit real values.
SUPABASE_SECRET_KEY=
LEADFLOW_PUBLIC_ORIGIN=https://example.com
AUTH_CALLBACK_ORIGIN=https://example.com
PUBLIC_ENQUIRIES_ENABLED=false
LEAD_GUARD_PROVIDER=postgres
LEAD_GUARD_HASH_SECRET=
LEADFLOW_DUPLICATE_MERGE_ENABLED=false

# Optional model; keep blank for deterministic rules. Select an available model.
GEMINI_API_KEY=
GEMINI_MODEL=

# Worker and customer/owner transactional mail remain off until reviewed setup.
CRON_SECRET=
LEADFLOW_AUTOMATION_ENABLED=false
LEADFLOW_EMAIL_ENABLED=false
LEADFLOW_FOLLOWUPS_ENABLED=false
LEADFLOW_WEEKLY_REPORTS_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Test mode only. Never enter live keys.
LEADFLOW_BILLING_MODE=disabled
LEADFLOW_TEST_CHECKOUT_UI=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
LEADFLOW_TEST_PLAN_CATALOGUE={"pilot":{"amount":50000,"currency":"INR","durationDays":30}}

# Explicit isolation for staging/preview; never set to the production project ref.
LEADFLOW_ENV=staging
LEADFLOW_STAGING_PROJECT_REF=
LEADFLOW_EMAIL_MODE=sandbox

LEADFLOW_ONBOARDING_ENABLED=false

LEADFLOW_ANALYTICS_ENABLED=false
LEADFLOW_PRIVACY_NOTICE_ENABLED=false
LEADFLOW_PRIVACY_TOOLS_ENABLED=false
PRIVACY_CONTACT_EMAIL=
