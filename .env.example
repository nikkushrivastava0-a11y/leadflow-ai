# Copy to .env.local for local development. NEVER commit .env.local.
# This file contains variable names and placeholders ONLY.
# Configure actual values in private deployment settings.

# Public Supabase project configuration.
# "NEXT_PUBLIC_" means this value will be available to browser code.
# Publishable / legacy anon keys are NOT secret, but row security (RLS) is essential.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-side model access. Never prefix the secret with NEXT_PUBLIC_.
# Configure a model supported by your API account; set usage/budget limits.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Razorpay checkout: public key id may be exposed, key secret must be server-only.
# DO NOT accept real customer payments until authenticated order ownership,
# server-side signature/amount verification and idempotent fulfillment work.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Do not store service-role keys, personal information, payment signatures,
# passwords or production database credentials in this file.
